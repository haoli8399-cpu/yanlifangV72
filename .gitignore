# ============================================================
# 演立方工作空间 — Monorepo .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
*.tsbuildinfo

# TanStack
.tanstack/

# Hermes internal (not project files)
.hermes/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Environment (SECURITY: never commit these)
.env
.env.local
.env.*.local
*.env
.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Miniprogram build
miniprogram/dist/

# Temporary
*.tmp
*.temp
*.orig
*.rej
*~
.cache/

# Project Memory runtime receipts/cache (overwrite-only, machine local)
.memory/

# Lock files (keep one; bun.lock is primary)
# codebase/package-lock.json already exists in repo, keep it

# Sensitive files
*.pem
*.key
*.cert
credentials.json
service-account.json
